# ExamPrep Platform - Environment Variables Template
# Copy this file to .env.local and replace placeholder values with actual secrets

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Configuration
# Get these values from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Stripe Configuration
# Get these from your Stripe dashboard
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Google Analytics
# Get this from your GA4 property
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# MCP Server Configuration
# Required for Claude Code MCP integrations
SUPABASE_ACCESS_TOKEN=sbp_157ad37e26885cf1112db105b4d94413a65b0881
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_your_github_token_here
VERCEL_API_TOKEN=your_vercel_api_token_here

# Security Notes:
# - NEVER commit .env.local to version control
# - Use environment-specific keys (test keys for development)
# - Rotate keys immediately if exposed
# - Store production secrets in Vercel/deployment platform securely

# --- Added variables required by code ---
# Server-side Supabase URL for admin/service clients
SUPABASE_URL=https://your-project-id.supabase.co

# Google Analytics (GA4) Measurement ID
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Stripe Price IDs used by plan config
NEXT_PUBLIC_STRIPE_PRICE_30D=price_30d_placeholder
NEXT_PUBLIC_STRIPE_PRICE_60D=price_60d_placeholder
NEXT_PUBLIC_STRIPE_PRICE_90D=price_90d_placeholder
NEXT_PUBLIC_STRIPE_PRICE_180D=price_180d_placeholder
